---
const {project}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<section class="project-release" data-release-widget data-repo={project.repo} data-transfer={project.transfer} aria-labelledby="release-heading">
 <div class="download-head"><h2 id="release-heading" tabindex="-1">{project.downloadTitle || "下载与更新"}</h2>{project.format && <span class="stamp">{project.format}</span>}</div>
 <p data-release-status role="status" aria-live="polite"></p>
 <div data-release-result hidden><div class="release-record"><h3 data-release-name></h3><time data-release-meta></time></div><div class="release-downloads" data-release-links></div></div>
 <p data-release-retry hidden><button type="button">重试</button></p>
 <noscript><p>启用 JavaScript 后即可查看下载链接。</p></noscript>
 {project.qr && <figure class="project-qr"><img src={`${base}${project.qr}`} width="112" height="112" alt={`${project.title}项目介绍页二维码`}/><figcaption>手机扫码打开项目页</figcaption></figure>}
</section>
<script is:inline type="module" src={`${base}project-releases.js`}></script>
