---
const base = import.meta.env.BASE_URL;
const hands = ['石头', '剪刀', '布'];
const dice = [[4],[0,8],[0,4,8],[0,2,6,8],[0,2,4,6,8],[0,2,3,5,6,8]];
---
<dialog id="mini-game-modal" aria-labelledby="mini-game-title">
  <svg class="mini-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      {dice.map((pips,i) => <symbol id={'mini-die-'+(i+1)} viewBox="0 0 64 64">
        <rect x="6" y="9" width="52" height="50" rx="10" fill="#be804f" stroke="#492e21" stroke-width="2" />
        <rect x="6" y="5" width="52" height="50" rx="10" fill="#fff4dc" stroke="#492e21" stroke-width="2.5" />
        {pips.map(p => <circle cx={19+p%3*13} cy={17+Math.floor(p/3)*13} r="4.4" fill={i===0 ? '#b94224' : '#492e21'} />)}
      </symbol>)}
      <symbol id="mini-hand-back" viewBox="0 0 64 64">
        <rect x="7" y="5" width="50" height="54" rx="11" fill="#a96043" stroke="#492e21" stroke-width="2.6"/>
        <rect x="12" y="10" width="40" height="44" rx="7" fill="none" stroke="#f6ddaa" stroke-width="2"/>
        <path d="m32 20 9 12-9 12-9-12Z" fill="#f6ddaa"/>
      </symbol>
      {hands.map((_, i) => <symbol id={'mini-hand-'+i} viewBox="0 0 64 64">
        <rect x="7" y="5" width="50" height="54" rx="11" fill={['#efd3b0','#f3deaa','#efd6a2'][i]} stroke="#492e21" stroke-width="2.6"/>
        <g fill="#c98354" stroke="#492e21" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
          {i===0 && <path d="M21 39l-3-7c-1-3 0-6 3-7 0-4 4-5 7-3 1-4 5-5 8-2 3-2 7 0 7 4 3 1 4 3 3 6l-2 9c-1 5-6 8-11 8h-4c-4-1-6-4-8-8Zm1-13 5 9 7-2c2 0 3 2 2 4l-5 4m-3-18 3 7m5-10 2 9m5-5 1 4"/>}
          {i===1 && <path d="M26 45c-4-2-7-6-8-10l-2-6c-1-3 2-5 4-3l5 6-6-16c-1-4 4-5 6-2l8 13 5-13c1-3 6-3 5 1l-2 15c4-3 7 0 6 3l-3 9c-2 5-6 7-11 7Zm0-13 5 4 5-3c3-1 5 2 3 4l-4 5"/>}
          {i===2 && <path d="M23 44l-8-11c-2-4 2-5 4-3l5 3-4-15c-1-4 4-5 6-2l4 10-2-14c0-4 5-4 6-1l3 15 2-13c1-4 6-3 6 1l-1 14 3-7c2-3 6-2 5 2l-4 15c-1 6-5 11-12 12-6 1-10-2-13-6Z"/>}
        </g>
      </symbol>)}
    </defs>
  </svg>
  <div class="mini-stage">
    <h2 class="mini-a11y" id="mini-game-title"></h2>
    <button type="button" data-mini-close aria-label="关闭小游戏">×</button>
    <div class="mini-score" id="mini-game-score"></div>
    <img class="mini-fage" data-mini-actor src={base+'assets/fage-welcome.webp'} alt="" width="343" height="650" />
    <div class="mini-arena" aria-hidden="true">
      <svg class="mini-token mini-player-token" viewBox="0 0 64 64" hidden><use id="mini-player-face" href="#mini-die-1" /></svg>
      <svg class="mini-token mini-fage-token" viewBox="0 0 64 64" hidden><use id="mini-fage-face" href="#mini-die-1" /></svg>
    </div>
    <p class="mini-a11y" id="mini-game-status" role="status" aria-live="polite" aria-atomic="true"></p>
    <div class="mini-controls" data-mini-dice><button type="button" data-mini-roll aria-label="掷骰子"><svg viewBox="0 0 64 64" aria-hidden="true"><use href="#mini-die-5" /></svg></button></div>
    <div class="mini-controls" data-mini-rps hidden>{hands.map((name,i)=><button type="button" data-mini-choice={i} aria-label={name}><svg viewBox="0 0 64 64" aria-hidden="true"><use href={'#mini-hand-'+i} /></svg></button>)}</div>
  </div>
</dialog>
<script is:inline type="module" src={base+'mini-games.js'}></script>
