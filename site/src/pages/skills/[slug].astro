---
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('skills')).filter(item=>item.data.published).map(skill=>({params:{slug:skill.id},props:{skill}}));}
const {skill}=Astro.props;
const {Content}=await render(skill);
const base=import.meta.env.BASE_URL;
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{skill.data.title} · HiFage</title><link rel="stylesheet" href={`${base}skills.css`}/></head><body><main><a href={`${base}skills/`}>← 返回 Skill 盒</a><h1>{skill.data.title}</h1><p>{skill.data.description}</p><article><Content /></article>{skill.data.downloadUrl && <a href={skill.data.downloadUrl}>获取资源</a>}</main></body></html>
